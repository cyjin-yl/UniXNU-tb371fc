+// Route A extraction support for public restore images.
+// Layout follows types/decmpfs.go CMP_RSRC_ZLIB in go-apfs v1.0.32.
+// This bounded implementation is for files up to readerMaxDecoded (64 MiB).
+package apfs
+
+import (
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"github.com/blacktop/go-apfs/types"
+)
+
+func newZlibResourceFile(source *File, size uint64) (*File, error) {
+	if source.Size < 16 || size == 0 || size > readerMaxDecoded {
+		return nil, fmt.Errorf("zlib resource size outside bounded extractor: source=%d decoded=%d", source.Size, size)
+	}
+	header := make([]byte, 16)
+	if err := readFull(source, header, 0); err != nil {
+		return nil, err
+	}
+	dataOffset := uint64(binary.BigEndian.Uint32(header))
+	dataSize := uint64(binary.BigEndian.Uint32(header[8:]))
+	if dataOffset < 16 || dataOffset > uint64(source.Size) || dataSize < 8 || dataSize > uint64(source.Size)-dataOffset {
+		return nil, fmt.Errorf("zlib resource data geometry: offset=%d size=%d source=%d", dataOffset, dataSize, source.Size)
+	}
+	blockHeader := make([]byte, 8)
+	if err := readFull(source, blockHeader, int64(dataOffset)); err != nil {
+		return nil, err
+	}
+	payloadSize := uint64(binary.BigEndian.Uint32(blockHeader))
+	count := uint64(le.Uint32(blockHeader[4:]))
+	expected := (size + readerChunkSize - 1) / readerChunkSize
+	if count != expected || payloadSize < 4 || payloadSize > dataSize-4 || count*8 > payloadSize-4 {
+		return nil, fmt.Errorf("zlib resource block table geometry: blocks=%d expected=%d payload=%d data=%d", count, expected, payloadSize, dataSize)
+	}
+	// Offsets are relative to the little-endian block count, four bytes after
+	// the classic resource data offset. The leading payload length is BE.
+	base := dataOffset + 4
+	limit := base + payloadSize
+	table := make([]byte, count*8)
+	if err := readFull(source, table, int64(base+4)); err != nil {
+		return nil, err
+	}
+	previousEnd := base + 4 + uint64(len(table))
+	result := make([]byte, 0, int(size))
+	for i := uint64(0); i < count; i++ {
+		start := base + uint64(le.Uint32(table[i*8:]))
+		length := uint64(le.Uint32(table[i*8+4:]))
+		if start < previousEnd || start > limit || length == 0 || length > readerChunkSize+1 || length > limit-start {
+			return nil, fmt.Errorf("zlib resource block %d outside data or overlapping: start=%d length=%d previous=%d limit=%d", i, start, length, previousEnd, limit)
+		}
+		encoded := make([]byte, length)
+		if err := readFull(source, encoded, int64(start)); err != nil {
+			return nil, err
+		}
+		decodedSize := min(uint64(readerChunkSize), size-i*readerChunkSize)
+		decoded, err := decodeInline(encoded, decodedSize, cmpAttrZlib)
+		if err != nil {
+			return nil, fmt.Errorf("zlib resource block %d: %w", i, err)
+		}
+		result = append(result, decoded...)
+		previousEnd = start + length
+	}
+	if uint64(len(result)) != size {
+		return nil, fmt.Errorf("zlib resource decoded size mismatch")
+	}
+	return &File{ReaderAt: bytes.NewReader(result), Size: int64(size)}, nil
+}
+
+func isZlibResourceMethod(method uint32) bool {
+	return method == uint32(types.CMP_RSRC_ZLIB)
+}
