+package apfs
+
+import (
+	"bytes"
+	"compress/zlib"
+	"encoding/binary"
+	"io"
+	"testing"
+)
+
+// An independently assembled classic resource fork: two logical chunks,
+// one zlib stream and one stored chunk, with a resource-map trailer.
+func routeAZlibFixture() ([]byte, []byte) {
+	first := bytes.Repeat([]byte("Route A chunk data.\n"), 4000)[:65536]
+	last := []byte("end of launchd-like resource")
+	var compressed bytes.Buffer
+	w := zlib.NewWriter(&compressed)
+	w.Write(first)
+	w.Close()
+	blocks := [][]byte{compressed.Bytes(), append([]byte{0xff}, last...)}
+	payloadLength := 4 + 8*len(blocks)
+	for _, b := range blocks {
+		payloadLength += len(b)
+	}
+	dataOffset := 256
+	image := make([]byte, dataOffset+4+payloadLength+50)
+	binary.BigEndian.PutUint32(image, uint32(dataOffset))
+	binary.BigEndian.PutUint32(image[4:], uint32(dataOffset+4+payloadLength))
+	binary.BigEndian.PutUint32(image[8:], uint32(4+payloadLength))
+	binary.BigEndian.PutUint32(image[12:], 50)
+	binary.BigEndian.PutUint32(image[dataOffset:], uint32(payloadLength))
+	base := dataOffset + 4
+	le.PutUint32(image[base:], uint32(len(blocks)))
+	pos := 4 + 8*len(blocks)
+	for i, b := range blocks {
+		le.PutUint32(image[base+4+i*8:], uint32(pos))
+		le.PutUint32(image[base+8+i*8:], uint32(len(b)))
+		copy(image[base+pos:], b)
+		pos += len(b)
+	}
+	return image, append(first, last...)
+}
+
+func TestRouteAZlibResourceRead(t *testing.T) {
+	image, want := routeAZlibFixture()
+	src := &File{ReaderAt: bytes.NewReader(image), Size: int64(len(image))}
+	f, err := newCompressedFile(src, uint64(len(want)), 4)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := io.ReadAll(io.NewSectionReader(f, 0, f.Size))
+	if err != nil || !bytes.Equal(got, want) {
+		t.Fatalf("decoded mismatch: %v", err)
+	}
+	cross := make([]byte, 23)
+	n, err := f.ReadAt(cross, 65530)
+	if n != len(cross) || err != nil || !bytes.Equal(cross, want[65530:65553]) {
+		t.Fatal("cross-chunk read mismatch")
+	}
+}
+
+func TestRouteAZlibResourceRejectsMalformed(t *testing.T) {
+	cases := map[string]func([]byte){
+		"declared-data-outside-file": func(p []byte) { binary.BigEndian.PutUint32(p[8:], 0xffffffff) },
+		"wrong-count":                func(p []byte) { le.PutUint32(p[260:], 3) },
+		"block-inside-table":         func(p []byte) { le.PutUint32(p[264:], 4) },
+		"overlapping-blocks":         func(p []byte) { le.PutUint32(p[272:], le.Uint32(p[264:])) },
+		"block-outside-fork":         func(p []byte) { le.PutUint32(p[264:], 0xfffffff0) },
+		"oversized-compressed-block": func(p []byte) { le.PutUint32(p[268:], 65538) },
+		"bad-zlib-checksum":          func(p []byte) { off := 260 + le.Uint32(p[264:]); n := le.Uint32(p[268:]); p[off+n-1] ^= 0x40 },
+		"short-stored-chunk":         func(p []byte) { le.PutUint32(p[276:], le.Uint32(p[276:])-1) },
+	}
+	for name, modify := range cases {
+		t.Run(name, func(t *testing.T) {
+			image, want := routeAZlibFixture()
+			modify(image)
+			_, err := newCompressedFile(&File{ReaderAt: bytes.NewReader(image), Size: int64(len(image))}, uint64(len(want)), 4)
+			if err == nil {
+				t.Fatal("malformed resource accepted")
+			}
+		})
+	}
+}
