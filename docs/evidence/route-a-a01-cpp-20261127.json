  "static_observations": [
    {
      "id": "apple-path-prefix-and-vector-layout",
      "input": "04-kern_exec",
      "functions": [
        "exec_save_path",
        "exec_copyout_strings"
      ],
      "facts": [
        "The expanded exec_save_path writes executable_path= before the copied path and clears the reserved path area first.",
        "The expanded copyout descriptors terminate argv and envv separately, append the one saved-path item, then append ip_applec-1 items starting at ip_endenvv and terminate the apple vector.",
        "The pointer width remains conditional on the image's 64-bit-address flag; the reviewed kernel supports both branches."
      ],
      "limitation": "This closes the selected source-layout and first-item provenance questions only for a successful execution of these functions with valid image_params. It is not a captured process stack."
    },
    {
      "id": "selected-apple-publisher",
      "input": "04-kern_exec",
      "function": "exec_add_apple_strings",
      "facts": [
        "The complete expanded function starts ip_applec at one and uses explicit fixed key prefixes in all reviewed additions.",
        "Neither dyld_hw_tpro nor dyld_hw_tpro_pagers occurs in this entire retained translation-unit body; complete function review also found no branch constructing either key.",
        "security_config=0x%x remains an explicit publication using task_get_security_config(task). Its value is not proved zero.",
        "The HAS_MTE/HAS_MTE_EMULATION_SHIMS additions of has_sec_transition and sec_transition_policy are absent from this expanded function."
      ],
      "entire_body_literal_occurrences": {
        "dyld_hw_tpro": 0,
        "dyld_hw_tpro_pagers": 0
      },
      "limitation": "Literal absence is not a global no-writer proof. Other publishers, later stack or vector changes, task security_config inheritance and runtime state remain separate obligations."
    },
    {
      "id": "selected-dyld-entry-and-stack-call-sites",
      "inputs": [
        "03-mach_loader",
        "04-kern_exec",
        "05-status"
      ],
      "facts": [
        "The selected mach_loader expansion builds pmap_flags from the 64-bit-address condition; its HAS_APPLE_PAC JOP flag branch is absent at the reviewed call site.",
